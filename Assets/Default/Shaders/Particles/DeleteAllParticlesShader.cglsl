#version 430
layout(local_size_x = 64) in;

struct Particle
{
	vec4 Position; // xyz, w = Size
	vec4 Velocity; // xyz, w = lifetime
	ivec4 Color; // x = ActiveColor, y = StartColor, z = EndColor, w = padding
	vec4 Gravity; // xyz, w = TextureIndex
	vec4 ChangeOverTime; // x = Min Size, y = Max Size, zw = padding
	vec4 Params; // x = MaxLife, y = Rotation, zw = Padding
};

layout(std430, binding = 0) buffer Data { Particle particle[]; };

void main()
{
	uint c = gl_GlobalInvocationID.x;
	particle[c].Velocity.w = 0.f;
}