#version 430
layout(local_size_x = 64) in;

layout(std140,binding=1) uniform SharedGPUParticlesBuffer
{
	vec3 Padding;
	float DeltaTime;
};

struct Particle
{
	vec4 Position; // xyz, w = Size
	vec4 Velocity; // xyz, w = lifetime
	ivec4 Color; // x = ActiveColor, y = StartColor, z = EndColor, w = padding
	vec4 Gravity; // xyz, w = TextureIndex
	vec4 ChangeOverTime; // x = Min Size, y = Max Size, zw = padding
	vec4 Params; // x = MaxLife, y = Rotation, zw = Padding
};

layout(std430, binding = 0) buffer Data { Particle particle[]; };
layout(std430, binding = 1) buffer FreeList { uint freeCount; uint freeIdx[]; };

void main()
{
	uint i = gl_GlobalInvocationID.x;

	Particle p = particle[i];
	if (p.Velocity.w <= 0.0) return;

	float DeltaLife = 1 - (p.Velocity.w / p.Params.x);

	p.Position.w = mix(p.ChangeOverTime.x, p.ChangeOverTime.y, DeltaLife);

uint s = uint(p.Color.y);
uint e = uint(p.Color.z);

uint StartColorR = (s >> 24) & 0xFFu;
uint StartColorG = (s >> 16) & 0xFFu;
uint StartColorB = (s >>  8) & 0xFFu;
uint StartColorA =  s        & 0xFFu;

uint EndColorR = (e >> 24) & 0xFFu;
uint EndColorG = (e >> 16) & 0xFFu;
uint EndColorB = (e >>  8) & 0xFFu;
uint EndColorA =  e        & 0xFFu;

	int R = int(round(mix(float(StartColorR), float(EndColorR), DeltaLife)));
	int G = int(round(mix(float(StartColorG), float(EndColorG), DeltaLife)));
	int B = int(round(mix(float(StartColorB), float(EndColorB), DeltaLife)));
	int A = int(round(mix(float(StartColorA), float(EndColorA), DeltaLife)));

	p.Color.r = ((R << 24) | (G << 16) | (B << 8) | A);


	p.Velocity.xyz += p.Gravity.xyz * DeltaTime;
	p.Position.xyz += p.Velocity.xyz * DeltaTime;
	p.Velocity.w -= DeltaTime;

	if(p.Velocity.w <= 0)
	{
		uint index = atomicAdd(freeCount, 1u);
		freeIdx[index] = i;
	}

	particle[i] = p;
}