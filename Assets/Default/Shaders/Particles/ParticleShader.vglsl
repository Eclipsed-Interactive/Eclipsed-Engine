#version 460 core
layout(location = 0)in vec4 Position; // xyz, w = size
layout(location = 1)in vec4 Velocity; // xyz, w = lifetime
layout(location = 2)in ivec4 Color; // Color
layout(location = 3)in vec4 Gravity; // xyz, w = TextureIndex
layout(location = 4)in vec4 ChangeOverTime; // xyzw = padding
layout(location = 5)in vec4 Params; // x = MaxLife, y = Rotation, zw = Padding

struct Particle
{
	vec4 Position; // xyz, w = Size
	vec4 Velocity; // xyz, w = lifetime
	ivec4 Color; // x = ActiveColor, y = StartColor, z = EndColor, w = padding
	vec4 Gravity; // xyz, w = TextureIndex
	vec4 ChangeOverTime; // x = Min Size, y = Max Size, zw = padding
	vec4 Params; // x = MaxLife, y = Rotation, zw = Padding
};

layout(std430, binding = 0) readonly buffer Particles { Particle particles[]; };

layout(std140,binding=0) uniform CameraBuffer
{
    vec2 cameraPosition;
    vec2 cameraScale;
    float cameraRotation;
    float resolutionRatio;
};

out vec4 vColor;
out vec2 vCameraScale;
out float vScale;
out float vRotation;
out float vResolutionRatio;
out float vLifeTime;

out uint vTextureIndex;

void main()
{
    vLifeTime = Velocity.w;
    vTextureIndex = uint(Gravity.w);
    
    uint px = uint(Color.x);
    uint ColorR = (px >> 24) & 0xFFu;
    uint ColorG = (px >> 16) & 0xFFu;
    uint ColorB = (px >>  8) & 0xFFu;
    uint ColorA =  px        & 0xFFu;

    vColor = vec4(float(ColorR) / 255.f, float(ColorG) / 255.f, float(ColorB) / 255.f, float(ColorA) / 255.f);

    vScale = Position.w;
    vRotation = cameraRotation + Params.y;
    vCameraScale = cameraScale;
    vResolutionRatio = resolutionRatio;

    vec2 vtxPos = (Position.xy - cameraPosition) * cameraScale;
    vtxPos.x *= resolutionRatio;
    gl_Position = vec4(vtxPos, 0, 1);
};