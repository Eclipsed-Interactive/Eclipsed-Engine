#version 430
layout(local_size_x = 64) in;

layout(std140,binding=0) uniform ParticleSpawnBuffer
{
	vec3 Gravity;
	uint SpawnCount;

	vec3 EmitterPosition;
	uint FrameSeed;

	float MinSizeStart;
	float MaxSizeStart;
	float MinSizeEnd;
	float MaxSizeEnd;

	float SpawnLifeTimeMin;
	float SpawnLifeTimeMax;
	float StartSpeedMin;
	float StartSpeedMax;
	
	int StartColor;
	int EndColor;
	int pad3423;
	int pad97845;

	vec3 Padding12312;
	uint SpawnShape;
};

layout(std140,binding=2) uniform ConeEmitterDataBuffer
{
	float pad725;
	float pad432;

	float EmitterWidthAngle;
	float EmitterRotation;
};

struct Particle
{
	vec4 Position; // xyz, w = Size
	vec4 Velocity; // xyz, w = lifetime
	ivec4 Color; // x = ActiveColor, y = StartColor, z = EndColor, w = padding
	vec4 Gravity; // xyz, w = TextureIndex
	vec4 ChangeOverTime; // x = Min Size, y = Max Size, zw = padding
	vec4 Params; // x = MaxLife, y = Rotation, zw = Padding
};

layout(std430, binding = 0) buffer Data { Particle particle[]; };
layout(std430, binding = 1) buffer FreeList { uint freeCount; uint freeIdx[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}
float rand(inout uint s) { s = hash(s); return float(s) / 4294967295.0; }

vec3 ConeEmitterShape(inout uint seed)
{
    float rA = rand(seed);
    float rB = rand(seed);
    float rS = rand(seed);

    float coneAngle = radians(EmitterWidthAngle);
    float theta = rA * 6.2831853;
    float cosA  = mix(cos(coneAngle), 1.0, rB);
    float sinA  = sqrt(1.0 - cosA * cosA);

    // Local cone direction (axis = +Y, spread into X and Z)
    vec3 dir = vec3(sinA * cos(theta), cosA, sinA * sin(theta));

    // Rotate around Z axis
    float c = cos(EmitterRotation);
    float s = sin(EmitterRotation);
    vec3 rotated = vec3(
        dir.x * c - dir.y * s,
        dir.x * s + dir.y * c,
        dir.z
    );

    float speed = mix(StartSpeedMin, StartSpeedMax, rS);
    return rotated * speed;
}

vec3 SphericalEmitterShape(inout uint seed)
{
	float rS = rand(seed);

	float valRand = rand(seed);
	float piRand = abs(valRand) * 6.2831853;

	float velXRand = cos(piRand);
	float velYRand = sin(piRand);

    float speed = mix(StartSpeedMin, StartSpeedMax, rS);
	return vec3(velXRand, velYRand, 0) * speed;
}

void main()
{
	uint c = gl_GlobalInvocationID.x;
	if(c >= SpawnCount) return;

	uint old;
	do
	{
    	old = freeCount;
    	if (old == 0u) return;
	} while (atomicCompSwap(freeCount, old, old - 1u) != old);

	uint slot = freeIdx[old - 1u];

	uint seed = hash(hash(FrameSeed) ^ (c * 0x9E3779B9u));

	Particle p;
	p.Position.xyz = EmitterPosition;
	p.ChangeOverTime.x = mix(MinSizeStart, MaxSizeStart, rand(seed));
	p.ChangeOverTime.y = mix(MinSizeEnd, MaxSizeEnd, rand(seed));
	


	p.Color.y = StartColor;
	p.Color.z = EndColor;

	if(SpawnShape == 0)
	{
		p.Velocity.xyz = ConeEmitterShape(seed);
	}
	else if(SpawnShape == 1)
	{
		p.Velocity.xyz = SphericalEmitterShape(seed);
	}
	
	p.Velocity.w = mix(SpawnLifeTimeMin, SpawnLifeTimeMax, rand(seed));
	p.Params.x = p.Velocity.w;
	p.Params.y = 0;
	
	p.Gravity.xyz = Gravity;

	p.Gravity.w = mix(0, 7, rand(seed));

	particle[slot] = p;
}