#version 430
layout(local_size_x = 64) in;

layout(std140,binding=0) uniform ParticleSpawnBuffer
{
	vec3 Gravity;
	uint SpawnCount;
	vec3 EmitterPosition;
	uint FrameSeed;

	vec3 Padding;
	uint SpawnShape;
};

struct Particle
{
	vec4 Position; // xyz, w = size
	vec4 Velocity; // xyz, w = lifetime
	vec4 Color; // Color
	vec4 Gravity; // xyz, w = padding
	vec4 Params; // x = MaxLife, y = Rotation, zw = Padding
};

layout(std430, binding = 0) buffer Data { Particle particle[]; };
layout(std430, binding = 1) buffer FreeList { uint freeCount; uint freeIdx[]; };

uint hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}
float rand(inout uint s) { s = hash(s); return float(s) / 4294967295.0; }

vec3 ConeEmitterShape(float Rotation, uint seed)
{
    float rA = rand(seed);
    float rB = rand(seed);
    float rS = rand(seed);

    float coneAngle = radians(30.0);
    float theta = rA * 6.2831853;
    float cosA  = mix(cos(coneAngle), 1.0, rB);
    float sinA  = sqrt(1.0 - cosA * cosA);

    // Local cone direction (axis = +Y, spread into X and Z)
    vec3 dir = vec3(sinA * cos(theta), cosA, sinA * sin(theta));

    // Rotate around Z axis
    float c = cos(Rotation);
    float s = sin(Rotation);
    vec3 rotated = vec3(
        dir.x * c - dir.y * s,
        dir.x * s + dir.y * c,
        dir.z
    );

    float speed = mix(1.0, 1.4, rS);
    return rotated * speed;
}

vec3 SphericalEmitterShape(uint seed)
{
	float rS = rand(seed);

	float valRand = rand(seed);
	float piRand = abs(valRand) * 6.2831853;

	float velXRand = cos(piRand);
	float velYRand = sin(piRand);

	float speed = mix(0.5, 0.8, rS);
	return vec3(velXRand, velYRand, 0) * speed;
}

void main()
{
	uint c = gl_GlobalInvocationID.x;
	if(c >= SpawnCount) return;

	uint old;
	do
	{
    	old = freeCount;
    	if (old == 0u) return;
	} while (atomicCompSwap(freeCount, old, old - 1u) != old);

	uint slot = freeIdx[old - 1u];

	uint seed = hash(hash(FrameSeed) ^ (c * 0x9E3779B9u));

	Particle p;
	p.Position.xyz = EmitterPosition;
	p.Position.w = 0.02;

	if(SpawnShape == 0)
	{
		p.Velocity.xyz = ConeEmitterShape(0.8f, seed);
	}
	else if(SpawnShape == 1)
	{
		p.Velocity.xyz = SphericalEmitterShape(seed);
	}
	
	p.Velocity.w = 1.0;
	
	p.Color = vec4(1.0, 1.0, 1.0, 1.0);
	p.Gravity.xyz = Gravity;

	particle[slot] = p;
}