#version 460 core

layout(binding = 0) uniform sampler2D lights;
layout(binding = 1) uniform sampler2D shadows;

layout(std140, binding=7) uniform DirectionalLightBuffer
{
    vec4 color;
    vec2 rotation;
    float shadowLength;
    float intensity;
    int shadowSteps;
} directional;

layout(std140, binding=8) uniform AmbientLightBuffer
{
    vec4 color;
    float intensity;
} ambient;

// Ins
in vec2 outTexCoord;

// Outs
out vec4 frag_colour;

float Shadows()
{
    if(texture(shadows, outTexCoord).a > 0.5)
        return 0.0;

    vec2 stepUV = (normalize(directional.rotation) * directional.shadowLength) / directional.shadowSteps;

    vec2 uv = outTexCoord;
    for(int i = 1; i <= directional.shadowSteps; i++)
    {
        uv += stepUV;
        if(texture(shadows, uv).a == 1.0)
            return 1.0;
    }

    return 0.0; // No shadow
}

void main() 
{
    vec3 light = ambient.color.rgb * ambient.intensity
        + directional.color.rgb * directional.intensity * (1.0 - Shadows())
        + texture(lights, outTexCoord).rgb;

    frag_colour = vec4(light, 1.0);
}